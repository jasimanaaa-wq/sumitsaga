diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..97253b9
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,55 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    function signedIn() { return request.auth != null; }
+
+    match /groups/{groupId} {
+      allow read: if signedIn();
+
+      // Creator becomes the first member.
+      allow create: if signedIn()
+        && request.resource.data.organizerId == request.auth.uid
+        && request.resource.data.memberIds == [request.auth.uid]
+        && request.resource.data.memberCount == 1
+        && request.resource.data.maxMembers is int
+        && request.resource.data.maxMembers >= 2
+        && request.resource.data.maxMembers <= 20;
+
+      // Only membership fields can change, and only for yourself.
+      allow update: if signedIn()
+        && request.resource.data.diff(resource.data).affectedKeys()
+             .hasOnly(['memberIds', 'memberCount', 'members'])
+        && (
+          // join (respecting capacity)
+          ( !(request.auth.uid in resource.data.memberIds)
+            && request.auth.uid in request.resource.data.memberIds
+            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
+            && request.resource.data.memberCount == resource.data.memberCount + 1
+            && request.resource.data.memberCount <= resource.data.maxMembers )
+          ||
+          // leave (organizer cannot leave)
+          ( request.auth.uid in resource.data.memberIds
+            && !(request.auth.uid in request.resource.data.memberIds)
+            && request.auth.uid != resource.data.organizerId
+            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
+            && request.resource.data.memberCount == resource.data.memberCount - 1 )
+        );
+
+      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
+
+      // Chat: only group members can read or post.
+      match /messages/{messageId} {
+        allow read: if signedIn()
+          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
+
+        allow create: if signedIn()
+          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
+          && request.resource.data.senderId == request.auth.uid
+          && request.resource.data.text is string
+          && request.resource.data.text.size() > 0
+          && request.resource.data.text.size() <= 1000;
+      }
+    }
+  }
+}
diff --git a/hooks/use-user.ts b/hooks/use-user.ts
new file mode 100644
index 0000000..208fad0
--- /dev/null
+++ b/hooks/use-user.ts
@@ -0,0 +1,42 @@
+"use client"
+
+import { useEffect, useState, useCallback } from "react"
+import { onAuthStateChanged, signInAnonymously, type User } from "firebase/auth"
+import { getFirebaseAuth } from "@/lib/firebase"
+
+const NAME_KEY = "summitsaga-display-name"
+
+/**
+ * Anonymous Firebase auth + a locally remembered display name.
+ * `user.uid` is the stable identity used for group membership and chat messages.
+ */
+export function useUser() {
+  const [user, setUser] = useState<User | null>(null)
+  const [name, setNameState] = useState("")
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState<string | null>(null)
+
+  useEffect(() => {
+    setNameState(localStorage.getItem(NAME_KEY) ?? "")
+    const auth = getFirebaseAuth()
+    return onAuthStateChanged(auth, (u) => {
+      if (u) {
+        setUser(u)
+        setLoading(false)
+      } else {
+        signInAnonymously(auth).catch((e) => {
+          setError(e.message)
+          setLoading(false)
+        })
+      }
+    })
+  }, [])
+
+  const setName = useCallback((value: string) => {
+    const trimmed = value.trim().slice(0, 40)
+    localStorage.setItem(NAME_KEY, trimmed)
+    setNameState(trimmed)
+  }, [])
+
+  return { user, name, setName, loading, error }
+}
diff --git a/lib/firebase.ts b/lib/firebase.ts
new file mode 100644
index 0000000..9efbb94
--- /dev/null
+++ b/lib/firebase.ts
@@ -0,0 +1,20 @@
+import { initializeApp, getApps, getApp, type FirebaseApp } from "firebase/app"
+import { getAuth, type Auth } from "firebase/auth"
+import { getFirestore, type Firestore } from "firebase/firestore"
+
+const firebaseConfig = {
+  apiKey: process.env.NEXT_PUBLIC_FIREBASE_API_KEY,
+  authDomain: process.env.NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
+  projectId: process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID,
+  storageBucket: process.env.NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET,
+  messagingSenderId: process.env.NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
+  appId: process.env.NEXT_PUBLIC_FIREBASE_APP_ID,
+}
+
+// Lazy getters: only initialised in the browser, so `next build` doesn't need env vars.
+function getFirebaseApp(): FirebaseApp {
+  return getApps().length ? getApp() : initializeApp(firebaseConfig)
+}
+
+export const getDb = (): Firestore => getFirestore(getFirebaseApp())
+export const getFirebaseAuth = (): Auth => getAuth(getFirebaseApp())
