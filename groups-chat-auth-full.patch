diff --git a/components/auth-provider.tsx b/components/auth-provider.tsx
new file mode 100644
index 0000000..d80f729
--- /dev/null
+++ b/components/auth-provider.tsx
@@ -0,0 +1,60 @@
+"use client"
+
+import { createContext, useContext, useEffect, useState } from "react"
+import { onAuthStateChanged, signOut as fbSignOut, type User } from "firebase/auth"
+import { getFirebaseAuth } from "@/lib/firebase"
+
+type AuthState = {
+  user: User | null
+  /** Human-friendly name: profile name, else the part of the email before the @ */
+  name: string
+  loading: boolean
+  configError: string | null
+  signOut: () => Promise<void>
+  /** Re-read the profile (e.g. after updateProfile) and re-render */
+  refresh: () => Promise<void>
+}
+
+const AuthContext = createContext<AuthState | null>(null)
+
+export function displayNameOf(user: User | null) {
+  if (!user) return ""
+  return user.displayName?.trim() || user.email?.split("@")[0] || "Trekker"
+}
+
+export function AuthProvider({ children }: { children: React.ReactNode }) {
+  const [user, setUser] = useState<User | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [configError, setConfigError] = useState<string | null>(null)
+  const [, setTick] = useState(0)
+
+  useEffect(() => {
+    try {
+      return onAuthStateChanged(getFirebaseAuth(), (u) => {
+        setUser(u)
+        setLoading(false)
+      })
+    } catch (e) {
+      setConfigError(e instanceof Error ? e.message : "Firebase is not configured")
+      setLoading(false)
+    }
+  }, [])
+
+  const signOut = () => fbSignOut(getFirebaseAuth())
+  const refresh = async () => {
+    await getFirebaseAuth().currentUser?.reload()
+    setTick((t) => t + 1)
+  }
+
+  return (
+    <AuthContext.Provider value={{ user, name: displayNameOf(user), loading, configError, signOut, refresh }}>
+      {children}
+    </AuthContext.Provider>
+  )
+}
+
+export function useAuth() {
+  const ctx = useContext(AuthContext)
+  if (!ctx) throw new Error("useAuth must be used inside <AuthProvider>")
+  return ctx
+}
diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..09b2b9f
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,59 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    // Real accounts only (email/Google) - anonymous sessions are rejected.
+    function signedIn() {
+      return request.auth != null
+        && request.auth.token.firebase.sign_in_provider != 'anonymous';
+    }
+
+    match /groups/{groupId} {
+      allow read: if signedIn();
+
+      // Creator becomes the first member.
+      allow create: if signedIn()
+        && request.resource.data.organizerId == request.auth.uid
+        && request.resource.data.memberIds == [request.auth.uid]
+        && request.resource.data.memberCount == 1
+        && request.resource.data.maxMembers is int
+        && request.resource.data.maxMembers >= 2
+        && request.resource.data.maxMembers <= 20;
+
+      // Only membership fields can change, and only for yourself.
+      allow update: if signedIn()
+        && request.resource.data.diff(resource.data).affectedKeys()
+             .hasOnly(['memberIds', 'memberCount', 'members'])
+        && (
+          // join (respecting capacity)
+          ( !(request.auth.uid in resource.data.memberIds)
+            && request.auth.uid in request.resource.data.memberIds
+            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
+            && request.resource.data.memberCount == resource.data.memberCount + 1
+            && request.resource.data.memberCount <= resource.data.maxMembers )
+          ||
+          // leave (organizer cannot leave)
+          ( request.auth.uid in resource.data.memberIds
+            && !(request.auth.uid in request.resource.data.memberIds)
+            && request.auth.uid != resource.data.organizerId
+            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
+            && request.resource.data.memberCount == resource.data.memberCount - 1 )
+        );
+
+      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
+
+      // Chat: only group members can read or post.
+      match /messages/{messageId} {
+        allow read: if signedIn()
+          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
+
+        allow create: if signedIn()
+          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
+          && request.resource.data.senderId == request.auth.uid
+          && request.resource.data.text is string
+          && request.resource.data.text.size() > 0
+          && request.resource.data.text.size() <= 1000;
+      }
+    }
+  }
+}
diff --git a/hooks/use-user.ts b/hooks/use-user.ts
new file mode 100644
index 0000000..3f3ed9c
--- /dev/null
+++ b/hooks/use-user.ts
@@ -0,0 +1,23 @@
+"use client"
+
+import { useEffect } from "react"
+import { usePathname, useRouter } from "next/navigation"
+import { useAuth } from "@/components/auth-provider"
+
+/**
+ * For pages that need a signed-in user: sends visitors to /login (and back afterwards).
+ * `ready` is true only once a user is available.
+ */
+export function useRequireUser() {
+  const auth = useAuth()
+  const router = useRouter()
+  const pathname = usePathname()
+
+  useEffect(() => {
+    if (!auth.loading && !auth.user && !auth.configError) {
+      router.replace(`/login?next=${encodeURIComponent(pathname)}`)
+    }
+  }, [auth.loading, auth.user, auth.configError, router, pathname])
+
+  return { ...auth, ready: !auth.loading && !!auth.user }
+}
diff --git a/lib/firebase.ts b/lib/firebase.ts
